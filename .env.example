# SEC requires callers to identify themselves. Use your real app/org and email.
# Required to rebuild the database from live sources (scripts/build_db.py without --offline).
SEC_USER_AGENT="agent-techhome your-real-email@example.com"

# Optional. Used by the agent's answer composer via the openai package.
# If unset, a deterministic fallback composer runs instead, so the app and
# evals remain runnable keyless -- with no LLM-generated prose in that mode.
OPENAI_API_KEY=""
